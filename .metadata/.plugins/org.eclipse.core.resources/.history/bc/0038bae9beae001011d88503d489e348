static void log_uart(const char* fmt, ...)
{
  char buf[160];
  va_list ap; va_start(ap, fmt);
  int n = vsnprintf(buf, sizeof(buf), fmt, ap);
  va_end(ap);
  if (n < 0) return;
  size_t len = strnlen(buf, sizeof(buf));
  HAL_UART_Transmit(&huart2, (uint8_t*)buf, (uint16_t)len, 200);
}

/************ Audio ************/
static void WT_InitSine(void) {
  for (u32 i = 0; i < WT_SIZE; ++i) {
    float s = sinf(2.0f * 3.14159265359f * (float)i / (float)WT_SIZE);
    wavetable[i] = (uint16_t)((s * 0.49f + 0.5f) * (float)DAC_MAX_12B);
  }
}

static inline void Audio_SetFrequency(float freq_hz) {
  if (freq_hz <= 0.0f) { phase_inc_q16 = 0; return; }
  float step = (freq_hz * (float)WT_SIZE) / (float)AUDIO_FS_HZ;
  phase_inc_q16 = (u32)(step * 65536.0f);
}

static void FillHalf(u32 offset, u32 len) {
  if (phase_inc_q16 == 0) {
    for (u32 i = 0; i < len; ++i) audio_buf[offset + i] = DAC_OFFSET_12B;
    return;
  }
  for (u32 i = 0; i < len; ++i) {
    u32 idx = (phase_q16 >> 16) & (WT_SIZE - 1);
    audio_buf[offset + i] = wavetable[idx];
    phase_q16 += phase_inc_q16;
  }
}

static void Audio_Start(void) {
  if (audio_running) return;

  WT_InitSine();
  phase_q16 = 0;

  for (u32 i = 0; i < AUDIO_BUF_SAMPLES; ++i) {
    u32 idx = (phase_q16 >> 16) & (WT_SIZE - 1);
    audio_buf[i] = wavetable[idx];
    phase_q16 += phase_inc_q16;
  }

  if (HAL_DAC_Start(&hdac, DAC_CHANNEL_1) != HAL_OK) Error_Handler();
  if (HAL_DAC_Start_DMA(&hdac, DAC_CHANNEL_1,
                        (uint32_t*)audio_buf, AUDIO_BUF_SAMPLES, DAC_ALIGN_12B_R) != HAL_OK) Error_Handler();
  if (HAL_TIM_Base_Start(&htim6) != HAL_OK) Error_Handler();

  audio_running = 1;
}

/************ Player NO BLOQUEANTE ************/
static inline uint32_t NoteDurMs(const Note* n, uint32_t tempo_ms)
{
  uint32_t d = (uint32_t)n->dur_beats * tempo_ms / 4U;
  if (d == 0) d = 1;
  return d;
}

static void MelodyStart(const Note* mel, unsigned count, uint32_t tempo_ms, uint8_t src_pin)
{
  if (!mel || count == 0) {
    cur_mel = NULL; cur_len = 0; cur_idx = 0; cur_stage = 0; cur_src_pin = 0;
    Audio_SetFrequency(0.0f);
    return;
  }
  cur_mel   = mel;
  cur_len   = count;
  cur_tempo = tempo_ms;
  cur_idx   = 0;
  cur_stage = 0;
  cur_src_pin = src_pin;

  uint32_t now = HAL_GetTick();
  Audio_SetFrequency(cur_mel[0].freq_hz);   /* cambio inmediato */
  if (!audio_running) Audio_Start();
  stage_end_ms = now + NoteDurMs(&cur_mel[0], cur_tempo);
}

static void MelodyService(void)
{
  if (!cur_mel || cur_idx >= cur_len) return;
  uint32_t now = HAL_GetTick();
  if (now < stage_end_ms) return;

  if (cur_stage == 0) {
    /* gap */
    Audio_SetFrequency(0.0f);
    uint32_t dur = NoteDurMs(&cur_mel[cur_idx], cur_tempo) / GAP_DIVISOR;
    if (dur == 0) dur = 1;
    stage_end_ms = now + dur;
    cur_stage = 1;
  } else {
    /* siguiente nota */
    cur_idx++;
    if (cur_idx >= cur_len) {
      cur_mel = NULL; cur_len = 0; cur_src_pin = 0;
      Audio_SetFrequency(0.0f);
      return;
    }
    Audio_SetFrequency(cur_mel[cur_idx].freq_hz);
    stage_end_ms = now + NoteDurMs(&cur_mel[cur_idx], cur_tempo);
    cur_stage = 0;
  }
}

/************ SD ************/
static FRESULT SD_Mount(void)    { return f_mount(&g_fs, "", 1); }
static FRESULT SD_Unmount(void)  { return f_mount(NULL, "", 0); }

static FRESULT LoadMelodyFromCSV(const char* path, Note* out_buf, size_t max_notes, unsigned* out_count)
{
  *out_count = 0;
  FRESULT fr = f_open(&g_file, path, FA_READ);
  if (fr != FR_OK) return fr;

  char line[LINE_MAX];
  while (f_gets(line, sizeof(line), &g_file)) {
    char* p = line;
    while (*p==' ' || *p=='\t') ++p;
    if (*p=='#' || *p=='\r' || *p=='\n' || *p=='\0') continue;

    char* sep = strchr(p, ','); if (!sep) sep = strchr(p, ';'); if (!sep) continue;
    *sep = '\0';
    float    freq = strtof(p, NULL);
    unsigned dur  = (unsigned)strtoul(sep+1, NULL, 10);

    if (*out_count < max_notes) {
      out_buf[*out_count].freq_hz   = freq;             /* 0=REST */
      out_buf[*out_count].dur_beats = (uint8_t)(dur & 0xFF);
      (*out_count)++;
    } else break;
  }

  f_close(&g_file);
  return FR_OK;
}

static void ListDir(const char* path)
{
  DIR dir; FILINFO fno;
  FRESULT fr = f_opendir(&dir, path);
  log_uart("dir %s -> %d\r\n", path, fr);
  if (fr != FR_OK) return;
  for (;;) {
    fr = f_readdir(&dir, &fno);
    if (fr != FR_OK || fno.fname[0] == 0) break;
    log_uart(" - %s%s\r\n", fno.fname, (fno.fattrib & AM_DIR) ? "/" : "");
  }
  f_closedir(&dir);
}

static FRESULT TryOpenList(const char* const* list, size_t n, Note* buf, unsigned* out_cnt)
{
  FRESULT last = FR_NO_FILE; *out_cnt = 0;
  for (size_t i = 0; i < n; ++i) {
    last = LoadMelodyFromCSV(list[i], buf, MELODY_MAX_NOTES, out_cnt);
    log_uart("open path='%s' -> fr=%d, count=%u\r\n", list[i], last, *out_cnt);
    if (last == FR_OK && *out_cnt > 0) return FR_OK;
  }
  return last;
}

/************ SPI raw ************/
static uint8_t spi2_txrx(uint8_t b)
{
  uint8_t r = 0xFF;
  HAL_SPI_TransmitReceive(&hspi2, &b, &r, 1, 100);
  return r;
}

static void SD_RawCMD0_Test(void)
{
  log_uart("RAW CMD0 test...\r\n");
  HAL_SPI_DeInit(&hspi2);
  hspi2.Init.BaudRatePrescaler = SPI_BAUDRATEPRESCALER_256;
  if (HAL_SPI_Init(&hspi2) != HAL_OK) Error_Handler();

  HAL_GPIO_WritePin(SD_CS_GPIO_Port, SD_CS_Pin, GPIO_PIN_SET);
  HAL_Delay(2);
  for (int i=0; i<10; ++i) spi2_txrx(0xFF);

  HAL_GPIO_WritePin(SD_CS_GPIO_Port, SD_CS_Pin, GPIO_PIN_RESET);
  uint8_t cmd[6] = {0x40,0,0,0,0,0x95};
  for (int i=0;i<6;i++) (void)spi2_txrx(cmd[i]);

  uint8_t resp[10];
  for (int i=0;i<10;i++) resp[i] = spi2_txrx(0xFF);

  HAL_GPIO_WritePin(SD_CS_GPIO_Port, SD_CS_Pin, GPIO_PIN_SET);
  spi2_txrx(0xFF);

  log_uart("RAW CMD0 resp:"); for (int i=0;i<10;i++) log_uart(" %02X", resp[i]); log_uart("\r\n");

  HAL_SPI_DeInit(&hspi2);
  hspi2.Init.BaudRatePrescaler = SPI_BAUDRATEPRESCALER_16;
  if (HAL_SPI_Init(&hspi2) != HAL_OK) Error_Handler();
}

/************ Entradas ************/
static uint8_t DebounceReadHigh(GPIO_TypeDef* port, uint16_t pin, uint32_t ms)
{
  if (HAL_GPIO_ReadPin(port, pin) != GPIO_PIN_SET) return 0;
  uint32_t t0 = HAL_GetTick();
  while ((HAL_GetTick() - t0) < ms) {
    if (HAL_GPIO_ReadPin(port, pin) != GPIO_PIN_SET) return 0;
    HAL_Delay(1);
  }
  return 1;
}

/* Servicio por NIVEL con prioridad PC4 > PC3 > PC2 */
static void LevelPreemptService(void)
{
  uint8_t h2 = DebounceReadHigh(TRIG1_GPIO_Port, TRIG1_Pin, DEBOUNCE_MS);
  uint8_t h3 = DebounceReadHigh(TRIG2_GPIO_Port, TRIG2_Pin, DEBOUNCE_MS);
  uint8_t h4 = DebounceReadHigh(TRIG3_GPIO_Port, TRIG3_Pin, DEBOUNCE_MS);

  uint8_t desired = 0;
  if (h4) desired = 4;
  else if (h3) desired = 3;
  else if (h2) desired = 2;

  if (!desired) return;

  uint32_t now = HAL_GetTick();
  if (desired == 2 && (now - last_fire_pc2) < RETRIGGER_BLANK_MS && cur_src_pin == 2) return;
  if (desired == 3 && (now - last_fire_pc3) < RETRIGGER_BLANK_MS && cur_src_pin == 3) return;
  if (desired == 4 && (now - last_fire_pc4) < RETRIGGER_BLANK_MS && cur_src_pin == 4) return;

  if (desired != cur_src_pin) {
    const Note* mel = NULL; unsigned cnt = 0;
    if (desired == 2) { mel = (g_melody1_count? g_melody1:IMPERIAL_MARCH); cnt = (g_melody1_count? g_melody1_count:IMPERIAL_MARCH_LEN); last_fire_pc2 = now; }
    else if (desired == 3) { mel = (g_melody2_count? g_melody2:IMPERIAL_MARCH); cnt = (g_melody2_count? g_melody2_count:IMPERIAL_MARCH_LEN); last_fire_pc3 = now; }
    else { mel = (g_melody3_count? g_melody3:IMPERIAL_MARCH); cnt = (g_melody3_count? g_melody3_count:IMPERIAL_MARCH_LEN); last_fire_pc4 = now; }

    log_uart("[LEVEL] preempt to PC%u (%u notes)\r\n", desired, cnt);
    MelodyStart(mel, cnt, CSV_TEMPO_MS, desired);  /* cambio inmediato */
  }
}

/************ main ************/
int main(void)
{
  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_USART2_UART_Init();
  MX_SPI2_Init();
  MX_DAC_Init();
  MX_TIM6_Init();
  MX_FATFS_Init();
  MX_DMA_Init();

  /* Forzamos Fs=20kHz exacto */
  __HAL_TIM_SET_PRESCALER(&htim6, 83);
  __HAL_TIM_SET_AUTORELOAD(&htim6, 49);
  HAL_TIM_GenerateEvent(&htim6, TIM_EVENTSOURCE_UPDATE);

  /* DAC con TRGO de TIM6 */
  DAC_ChannelConfTypeDef s = {0};
  s.DAC_Trigger = DAC_TRIGGER_T6_TRGO;
  s.DAC_OutputBuffer = DAC_OUTPUTBUFFER_ENABLE;
  if (HAL_DAC_ConfigChannel(&hdac, &s, DAC_CHANNEL_1) != HAL_OK) Error_Handler();

  /* Beep de vida */
  Audio_SetFrequency(1000.0f);
  Audio_Start();
  HAL_Delay(120);
  Audio_SetFrequency(0.0f);

  /* (opcional) tests SPI/SD */
  SD_RawCMD0_Test();

  /* Carga 3 CSV */
  if (SD_Mount() == FR_OK) {
    ListDir("/");
    ListDir("/MELODIES");

    const char* candidates1[] = {"MELODIES/MELODIA1.CSV","/MELODIES/MELODIA1.CSV","0:/MELODIES/MELODIA1.CSV","0:MELODIES/MELODIA1.CSV"};
    const char* candidates2[] = {"MELODIES/MELODIA2.CSV","/MELODIES/MELODIA2.CSV","0:/MELODIES/MELODIA2.CSV","0:MELODIES/MELODIA2.CSV"};
    const char* candidates3[] = {"MELODIES/MELODIA3.CSV","/MELODIES/MELODIA3.CSV","0:/MELODIES/MELODIA3.CSV","0:MELODIES/MELODIA3.CSV"};

    (void)TryOpenList(candidates1, 4, g_melody1, &g_melody1_count);
    (void)TryOpenList(candidates2, 4, g_melody2, &g_melody2_count);
    (void)TryOpenList(candidates3, 4, g_melody3, &g_melody3_count);
    SD_Unmount();
  }
  log_uart("CSV1=%u CSV2=%u CSV3=%u\r\n", g_melody1_count, g_melody2_count, g_melody3_count);

  while (1) {
    /* Servicio por nivel (preempción inmediata) */
    LevelPreemptService();

    /* Avanza nota/gap */
    MelodyService();

    HAL_Delay(POLL_MS);
  }
}

