/* USER CODE BEGIN PD */
/* Frecuencia de muestreo del DAC (TIM6 -> TRGO) */
#define AUDIO_FS_HZ           22050U

/* Tabla seno / DDS */
#define SINE_BITS             8
#define SINE_LEN              (1U << SINE_BITS)   // 256
#define AUDIO_BUF_LEN         512                 // Doble de 256; half callbacks a 256
#define DAC_MID               2048U               // Offset 12 bits (0..4095)
#define VOLUME_MAX            4095U               // Ganancia simple (0..4095)
/* USER CODE END PD */

/* Private macro -------------------------------------------------------------*/
/* USER CODE BEGIN PM */
#define CLAMP_U32(x,lo,hi)    ((x)<(lo)?(lo):((x)>(hi)?(hi):(x)))
/* USER CODE END PM */

/* Private variables ---------------------------------------------------------*/
DAC_HandleTypeDef hdac;
DMA_HandleTypeDef hdma_dac1;
TIM_HandleTypeDef htim6;
UART_HandleTypeDef huart2;

/* USER CODE BEGIN PV */
/* Audio / DDS estado */
static uint16_t     audioBuf[AUDIO_BUF_LEN];
static uint16_t     sineTable[SINE_LEN];
static volatile uint32_t dds_phase = 0;       // 32-bit phase accumulator
static volatile uint32_t dds_phaseInc = 0;    // incremento por muestra
static volatile uint32_t g_volume = 1500;     // volumen inicial (0..4095)

/* Si no quieres sonido (pausa), deja phaseInc en 0 */
static inline void DDS_SetFrequency(uint32_t freqHz) {
  if (freqHz == 0) {
    dds_phaseInc = 0;
    return;
  }
  /* phaseInc = (freq / Fs) * 2^32 */
  uint64_t inc = ((uint64_t)freqHz << 32) / AUDIO_FS_HZ;
  dds_phaseInc = (uint32_t)inc;
}

static inline void DDS_SetVolume(uint32_t vol) {
  g_volume = CLAMP_U32(vol, 0, VOLUME_MAX);
}
/* USER CODE END PV */

