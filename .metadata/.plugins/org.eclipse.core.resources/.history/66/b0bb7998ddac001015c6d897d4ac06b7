/* USER CODE BEGIN 0 */
void HAL_DAC_ConvHalfCpltCallbackCh1(DAC_HandleTypeDef* hdacx) {
  /* rellenar primera mitad */
  Audio_Fill(&audioBuf[0], AUDIO_BUF_LEN/2);
}
void HAL_DAC_ConvCpltCallbackCh1(DAC_HandleTypeDef* hdacx) {
  /* rellenar segunda mitad */
  Audio_Fill(&audioBuf[AUDIO_BUF_LEN/2], AUDIO_BUF_LEN/2);
}

static void Audio_Fill(uint16_t *dst, uint32_t n) {
  /* Genera seno 12 bits con DDS (tabla de 8 bits para indice) */
  for (uint32_t i = 0; i < n; ++i) {
    dds_phase += dds_phaseInc;
    /* Usamos los bits [31:24] como indice (256 entradas) */
    uint8_t idx = (uint8_t)(dds_phase >> (32 - SINE_BITS));
    uint16_t s  = sineTable[idx];     // 0..4095 escalado
    /* Aplicar volumen (lineal simple) alrededor de DAC_MID */
    int32_t centered = (int32_t)s - (int32_t)DAC_MID;       // -2048..+2047
    centered = (centered * (int32_t)g_volume) / (int32_t)VOLUME_MAX;
    uint16_t out = (uint16_t)CLAMP_U32((uint32_t)(centered + (int32_t)DAC_MID), 0, 4095);
    dst[i] = out;
  }
}

static void Audio_InitSine(void) {
  /* Construye tabla seno centrada en 2048 (12 bits) */
  for (uint32_t i = 0; i < SINE_LEN; ++i) {
    double theta = (2.0 * 3.141592653589793 * (double)i) / (double)SINE_LEN;
    /* amplitud ~ 0.9 full-scale para margen */
    double s = sin(theta);
    int32_t sample = (int32_t)(DAC_MID + (s * 0.9 * (double)DAC_MID));
    if (sample < 0) sample = 0;
    if (sample > 4095) sample = 4095;
    sineTable[i] = (uint16_t)sample;
  }
}

static void Audio_Start(void) {
  /* Llenar buffer inicialmente (silencio: phaseInc=0) */
  DDS_SetFrequency(0);
  Audio_Fill(audioBuf, AUDIO_BUF_LEN);

  /* Arrancar TIM6 (TRGO Update), DAC y DMA circular */
  HAL_TIM_Base_Start(&htim6);
  HAL_DAC_Start_DMA(&hdac, DAC_CHANNEL_1, (uint32_t*)audioBuf, AUDIO_BUF_LEN, DAC_ALIGN_12B_R);
}

/* Nota en Hz (0 = silencio) */
static void playNoteHz(uint32_t freq, uint32_t ms) {
  DDS_SetFrequency(freq);
  HAL_Delay(ms);
  /* breve “gap” opcional para separar notas si se desea:
     DDS_SetFrequency(0); HAL_Delay(2);
  */
}

/* Nota via NOTE_* de pitches.h */
static void playNote(uint32_t note_const, uint32_t ms) {
  playNoteHz(note_const, ms);
}
