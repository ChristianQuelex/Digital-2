#include "main.h"
#include "melody_pcm.h"   // <-- incluye TU audio convertido (PCM_FS_HZ, PCM_NUM_SAMPLES, PCM_DATA)
#include <string.h>

/* --- Handles --- */
DAC_HandleTypeDef  hdac;
TIM_HandleTypeDef  htim6;

/* ========== Prototipos ========== */
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_DAC_Init(void);
static void MX_TIM6_Init_ApproxFS(uint32_t desired_fs_hz);
static void StartPCM_Playback_Loop(void);
void Error_Handler(void);

/* =============== main() =============== */
int main(void)
{
  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_DAC_Init();

  /* Configura TIM6 cerca de la Fs del header (no exacta para 44.1k con 84MHz) */
  MX_TIM6_Init_ApproxFS(PCM_FS_HZ);

  /* Arranca reproducción en LOOP circular */
  StartPCM_Playback_Loop();

  while (1) {
    HAL_Delay(1000);
  }
}

/* ========= Reprod. LOOP DAC+DMA ========= */
static void StartPCM_Playback_Loop(void)
{
  /* Arranca DAC CH1 */
  if (HAL_DAC_Start(&hdac, DAC_CHANNEL_1) != HAL_OK) Error_Handler();

  /* DMA circular de TODO el buffer (loop) */
  if (HAL_DAC_Start_DMA(&hdac, DAC_CHANNEL_1,
                        (uint32_t*)PCM_DATA,
                        PCM_NUM_SAMPLES,
                        DAC_ALIGN_12B_R) != HAL_OK) Error_Handler();

  /* Timer que marca la Fs (TRGO) */
  if (HAL_TIM_Base_Start(&htim6) != HAL_OK) Error_Handler();
}

/* ========= Clock 84 MHz (HSE 8MHz -> PLL) ========= */
void SystemClock_Config(void)
{
  RCC_OscInitTypeDef RCC_OscInitStruct = {0};
  RCC_ClkInitTypeDef RCC_ClkInitStruct = {0};

  __HAL_RCC_PWR_CLK_ENABLE();
  __HAL_PWR_VOLTAGESCALING_CONFIG(PWR_REGULATOR_VOLTAGE_SCALE3);

  /* HSE recomendado para mejor estabilidad que HSI en audio */
  RCC_OscInitStruct.OscillatorType = RCC_OSCILLATORTYPE_HSE;
  RCC_OscInitStruct.HSEState       = RCC_HSE_ON;
  RCC_OscInitStruct.HSIState       = RCC_HSI_OFF;
  RCC_OscInitStruct.PLL.PLLState   = RCC_PLL_ON;
  RCC_OscInitStruct.PLL.PLLSource  = RCC_PLLSOURCE_HSE;
  RCC_OscInitStruct.PLL.PLLM       = 8;                 // 8/8=1 MHz
  RCC_OscInitStruct.PLL.PLLN       = 336;               // 1*336=336 MHz
  RCC_OscInitStruct.PLL.PLLP       = RCC_PLLP_DIV4;     // 336/4=84 MHz SYSCLK
  RCC_OscInitStruct.PLL.PLLQ       = 7;                 // 48 MHz (USB si aplica)
  if (HAL_RCC_OscConfig(&RCC_OscInitStruct) != HAL_OK) Error_Handler();

  RCC_ClkInitStruct.ClockType      = RCC_CLOCKTYPE_HCLK|RCC_CLOCKTYPE_SYSCLK|
                                     RCC_CLOCKTYPE_PCLK1|RCC_CLOCKTYPE_PCLK2;
  RCC_ClkInitStruct.SYSCLKSource   = RCC_SYSCLKSOURCE_PLLCLK;
  RCC_ClkInitStruct.AHBCLKDivider  = RCC_SYSCLK_DIV1;   // 84 MHz
  RCC_ClkInitStruct.APB1CLKDivider = RCC_HCLK_DIV2;     // 42 MHz -> TIM6 = 84 MHz (x2)
  RCC_ClkInitStruct.APB2CLKDivider = RCC_HCLK_DIV1;     // 84 MHz
  if (HAL_RCC_ClockConfig(&RCC_ClkInitStruct, FLASH_LATENCY_2) != HAL_OK) Error_Handler();
}

/* ========= TIM6 ~Fs =========
   Fupdate = 84e6 / (PSC+1) / (ARR+1)
   Para Fs=44100 exacta no hay divisores enteros con 84 MHz.
   Elegimos una aproximación muy cercana: 43,750 Hz  (error ~0.79%).
   Solución: PSC=47 -> 84e6/(47+1)=1.75e6;  ARR=39 -> 1.75e6/(39+1)=43,750 Hz.
*/
static void MX_TIM6_Init_ApproxFS(uint32_t desired_fs_hz)
{
  TIM_MasterConfigTypeDef sMasterConfig = {0};

  htim6.Instance               = TIM6;
  htim6.Init.CounterMode       = TIM_COUNTERMODE_UP;
  htim6.Init.AutoReloadPreload = TIM_AUTORELOAD_PRELOAD_ENABLE;

  if (desired_fs_hz >= 43000u && desired_fs_hz <= 44500u) {
    /* Caso típico: header a 44.1k -> usamos ~43.75k */
    htim6.Init.Prescaler = 47;  // 48 divisor -> 1.75 MHz
    htim6.Init.Period    = 39;  // 1.75e6 / (39+1) = 43750 Hz
  } else if (desired_fs_hz == 48000u) {
    /* Exacto a 48 kHz */
    htim6.Init.Prescaler = 34;  // 35 -> 84e6/35=2.4MHz
    htim6.Init.Period    = 49;  // 2.4e6/50 = 48000
  } else { /* 22050/21875 aprox por defecto */
    htim6.Init.Prescaler = 79;  // 80 -> 1.05 MHz
    htim6.Init.Period    = 47;  // 1.05e6/48 = 21875 Hz
  }

  if (HAL_TIM_Base_Init(&htim6) != HAL_OK) Error_Handler();

  sMasterConfig.MasterOutputTrigger = TIM_TRGO_UPDATE;
  sMasterConfig.MasterSlaveMode     = TIM_MASTERSLAVEMODE_DISABLE;
  if (HAL_TIMEx_MasterConfigSynchronization(&htim6, &sMasterConfig) != HAL_OK) Error_Handler();
}

/* ========= DAC CH1 (PA4) ========= */
static void MX_DAC_Init(void)
{
  DAC_ChannelConfTypeDef sConfig = {0};

  __HAL_RCC_DAC_CLK_ENABLE();

  hdac.Instance = DAC;
  if (HAL_DAC_Init(&hdac) != HAL_OK) Error_Handler();

  sConfig.DAC_Trigger      = DAC_TRIGGER_T6_TRGO;       // TIM6 marca la cadencia
  sConfig.DAC_OutputBuffer = DAC_OUTPUTBUFFER_ENABLE;   // buffer ON
  if (HAL_DAC_ConfigChannel(&hdac, &sConfig, DAC_CHANNEL_1) != HAL_OK) Error_Handler();
}

