/************* SPI low-level *************/
static void sd_spi_tx(const uint8_t* data, uint16_t len)
{
  HAL_SPI_Transmit(&hspi2, (uint8_t*)data, len, HAL_MAX_DELAY);
}

static void sd_spi_rx(uint8_t* data, uint16_t len)
{
  HAL_SPI_Receive(&hspi2, data, len, HAL_MAX_DELAY);
}

static uint8_t sd_spi_txrx(uint8_t byte)
{
  uint8_t rx = 0xFF;
  HAL_SPI_TransmitReceive(&hspi2, &byte, &rx, 1, HAL_MAX_DELAY);
  return rx;
}

/************* Helpers *************/
static void sd_send_dummy_clocks(uint8_t nbytes)
{
  /* Min 74 clocks con CS alto; enviamos n bytes 0xFF */
  CS_HIGH();
  uint8_t ff = SD_DUMMY_BYTE;
  for (uint8_t i = 0; i < nbytes; ++i) sd_spi_tx(&ff, 1);
}

static int sd_wait_ready(uint32_t timeout_ms)
{
  uint32_t tickstart = HAL_GetTick();
  do {
    if (sd_spi_txrx(SD_DUMMY_BYTE) == SD_READY_TOKEN) return 1;
  } while ((HAL_GetTick() - tickstart) < timeout_ms);
  return 0; /* timeout */
}

/* Enviar comando (cmd es ya con 0x40 OR) */
static uint8_t sd_send_cmd(uint8_t cmd, uint32_t arg)
{
  uint8_t buf[6];

  /* Select card */
  CS_HIGH();
  sd_spi_txrx(SD_DUMMY_BYTE);
  CS_LOW();

  /* Esperar Ready */
  if (!sd_wait_ready(SD_CMD_TIMEOUT_MS)) {
    CS_HIGH();
    return 0xFF;
  }

  /* Comando */
  buf[0] = 0x40 | cmd;
  buf[1] = (uint8_t)(arg >> 24);
  buf[2] = (uint8_t)(arg >> 16);
  buf[3] = (uint8_t)(arg >> 8);
  buf[4] = (uint8_t)(arg);
  /* CRC válido solo para CMD0 y CMD8; en otros puede ser dummy */
  uint8_t crc = 0x01;
  if (cmd == 0)   crc = 0x95; /* CMD0 */
  if (cmd == 8)   crc = 0x87; /* CMD8 */

  buf[5] = crc;
  sd_spi_tx(buf, 6);

  /* Leer respuesta (R1) — hasta 8 bytes */
  uint8_t r1;
  for (int i = 0; i < 8; ++i) {
    r1 = sd_spi_txrx(SD_DUMMY_BYTE);
    if ((r1 & 0x80U) == 0) break;
  }
  return r1;
}

/* Recibir un bloque de datos de 512 bytes */
static int sd_rcvr_datablock(uint8_t* buff, uint32_t btr)
{
  uint32_t tick = HAL_GetTick();
  uint8_t token;
  do {
    token = sd_spi_txrx(SD_DUMMY_BYTE);
    if (token == SD_TOKEN_START_BLOCK) break;
  } while ((HAL_GetTick() - tick) < SD_RW_TIMEOUT_MS);
  if (token != SD_TOKEN_START_BLOCK) return 0;

  sd_spi_rx(buff, (uint16_t)btr);

  /* Descartar CRC */
  sd_spi_txrx(SD_DUMMY_BYTE);
  sd_spi_txrx(SD_DUMMY_BYTE);
  return 1;
}

/* Transmitir un bloque de 512 bytes con token (0xFE single, 0xFC multi, 0xFD stop) */
static int sd_xmit_datablock(const uint8_t* buff, uint8_t token)
{
  if (!sd_wait_ready(SD_RW_TIMEOUT_MS)) return 0;

  sd_spi_tx(&token, 1);
  if (token != 0xFD) {
    sd_spi_tx((uint8_t*)buff, 512);
    /* CRC dummy */
    uint8_t crc[2] = {0xFF, 0xFF};
    sd_spi_tx(crc, 2);

    /* Data response */
    uint8_t resp = sd_spi_txrx(SD_DUMMY_BYTE);
    if ((resp & 0x1F) != 0x05) return 0;
  }
  return 1;
}
