/**
  * @brief  Initializes a Drive
  * @param  pdrv: Physical drive number (0..)
  * @retval DSTATUS: Operation status
  */
DSTATUS USER_initialize(BYTE pdrv)
{
  /* USER CODE BEGIN INIT */
  if (pdrv != 0) return STA_NOINIT;

  /* Inicialmente CS alto */
  CS_HIGH();

  /* Bajar el baudrate de SPI si lo tenías muy alto; opcional. */
  // __HAL_SPI_DISABLE(&hspi2);
  // MODIFY_REG(hspi2.Instance->CR1, SPI_CR1_BR, SPI_BAUDRATEPRESCALER_256);
  // __HAL_SPI_ENABLE(&hspi2);

  /* 80+ clocks con CS alto */
  sd_send_dummy_clocks(10);

  CardType = 0;
  Stat = STA_NOINIT;

  /* CMD0: GO_IDLE_STATE */
  if (sd_send_cmd(0, 0) != 0x01) { CS_HIGH(); return Stat; }

  /* CMD8: CHECK VOLTAGE RANGE (2.7-3.6V) + pattern 0x1AA */
  uint8_t ocr[4] = {0};
  uint8_t r = sd_send_cmd(8, 0x000001AA);
  if (r == 0x01) {
    /* Leer 32-bit trailing de CMD8 */
    for (int i = 0; i < 4; ++i) ocr[i] = sd_spi_txrx(SD_DUMMY_BYTE);
    if (ocr[2] == 0x01 && ocr[3] == 0xAA) {
      /* SDv2: enviar ACMD41 con HCS hasta que salga 0 */
      do {
        r = sd_send_cmd(55, 0);        /* APP_CMD */
        r = sd_send_cmd(41, 1UL << 30);
      } while (r && (HAL_GetTick() % SD_INIT_TIMEOUT_MS));
      /* CMD58: Leer OCR */
      if (sd_send_cmd(58, 0) == 0) {
        for (int i = 0; i < 4; ++i) ocr[i] = sd_spi_txrx(SD_DUMMY_BYTE);
        CardType = (ocr[0] & 0x40) ? (CT_SD2 | CT_BLOCK) : CT_SD2;
      }
    }
  } else {
    /* SDv1/MMC: intentar ACMD41 o CMD1 */
    uint8_t cmd;
    if (sd_send_cmd(55, 0) <= 1 && sd_send_cmd(41, 0) <= 1) {
      CardType = CT_SD1; cmd = 41;
    } else {
      CardType = CT_MMC; cmd = 1;
    }
    do {
      r = sd_send_cmd(cmd, 0);
    } while (r && (HAL_GetTick() % SD_INIT_TIMEOUT_MS));
    /* Set R/W block length to 512 (CMD16) */
    if (sd_send_cmd(16, 512) != 0) CardType = 0;
  }

  CS_HIGH();
  sd_spi_txrx(SD_DUMMY_BYTE);

  if (CardType) {
    Stat &= ~STA_NOINIT;
  } else {
    Stat = STA_NOINIT;
  }

  /* Restaura baudrate si lo bajaste durante init */
  // __HAL_SPI_DISABLE(&hspi2);
  // MODIFY_REG(hspi2.Instance->CR1, SPI_CR1_BR, SPI_BAUDRATEPRESCALER_16);
  // __HAL_SPI_ENABLE(&hspi2);

  return Stat;
  /* USER CODE END INIT */
}

