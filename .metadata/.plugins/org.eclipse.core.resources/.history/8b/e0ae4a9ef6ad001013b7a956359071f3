/* USER CODE BEGIN Private_Define */
#define SD_DUMMY_BYTE           0xFFU
#define SD_TOKEN_START_BLOCK    0xFEU
#define SD_READY_TOKEN          0xFFU

/* Timeouts (ms) */
#define SD_CMD_TIMEOUT_MS       500U
#define SD_RW_TIMEOUT_MS        500U
#define SD_INIT_TIMEOUT_MS      1000U

/* Card type flags (simplified) */
#define CT_MMC    0x01
#define CT_SD1    0x02
#define CT_SD2    0x04
#define CT_BLOCK  0x08   /* Block addressing (SDHC/SDXC) */
/* USER CODE END Private_Define */

/* Private variables ---------------------------------------------------------*/

/* USER CODE BEGIN Private_Variables */
extern SPI_HandleTypeDef hspi2;       /* Usaremos SPI2 */

static volatile DSTATUS Stat = STA_NOINIT;
static BYTE CardType = 0;
