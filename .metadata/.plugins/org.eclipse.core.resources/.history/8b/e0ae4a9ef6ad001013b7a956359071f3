  /* USER CODE END STATUS */
}

/**
  * @brief  Reads Sector(s)
  */
DRESULT USER_read(BYTE pdrv, BYTE *buff, DWORD sector, UINT count)
{
  /* USER CODE BEGIN READ */
  if (pdrv != 0 || !count) return RES_PARERR;
  if (Stat & STA_NOINIT)   return RES_NOTRDY;

  /* Convertir a direccion por byte si no es SDHC */
  if (!(CardType & CT_BLOCK)) sector *= 512U;

  uint8_t r;
  if (count == 1) {
    r = sd_send_cmd(17, sector); /* CMD17: READ_SINGLE_BLOCK */
    if (r == 0 && sd_rcvr_datablock(buff, 512)) {
      CS_HIGH(); sd_spi_txrx(SD_DUMMY_BYTE);
      return RES_OK;
    }
  } else {
    r = sd_send_cmd(18, sector); /* CMD18: READ_MULTIPLE_BLOCK */
    if (r == 0) {
      do {
        if (!sd_rcvr_datablock(buff, 512)) break;
        buff += 512;
      } while (--count);
      /* STOP_TRANSMISSION */
      sd_send_cmd(12, 0);
    }
  }
  CS_HIGH(); sd_spi_txrx(SD_DUMMY_BYTE);
  return RES_ERROR;
  /* USER CODE END READ */
}

/**
  * @brief  Writes Sector(s)
  */
#if _USE_WRITE == 1
DRESULT USER_write(BYTE pdrv, const BYTE *buff, DWORD sector, UINT count)
{
  /* USER CODE BEGIN WRITE */
  if (pdrv != 0 || !count)    return RES_PARERR;
  if (Stat & STA_NOINIT)      return RES_NOTRDY;

  if (!(CardType & CT_BLOCK)) sector *= 512U;

  uint8_t r;
  if (count == 1) {
    r = sd_send_cmd(24, sector); /* CMD24: WRITE_BLOCK */
    if (r == 0 && sd_xmit_datablock(buff, 0xFE)) {
      CS_HIGH(); sd_spi_txrx(SD_DUMMY_BYTE);
      return RES_OK;
    }
  } else {
    r = sd_send_cmd(25, sector); /* CMD25: WRITE_MULTIPLE_BLOCK */
    if (r == 0) {
      do {
        if (!sd_xmit_datablock(buff, 0xFC)) break;
        buff += 512;
      } while (--count);
      /* Stop Tran token */
      sd_xmit_datablock(0, 0xFD);
    }
  }
  CS_HIGH(); sd_spi_txrx(SD_DUMMY_BYTE);
  return RES_ERROR;
  /* USER CODE END WRITE */
}
#endif /* _USE_WRITE */

/**
  * @brief  I/O control operation
  */
#if _USE_IOCTL == 1
DRESULT USER_ioctl(BYTE pdrv, BYTE cmd, void *buff)
{
  /* USER CODE BEGIN IOCTL */
  if (pdrv != 0) return RES_PARERR;
  if (Stat & STA_NOINIT) return RES_NOTRDY;

  DRESULT res = RES_ERROR;
  switch (cmd) {
    case CTRL_SYNC:
      if (sd_wait_ready(SD_RW_TIMEOUT_MS)) res = RES_OK;
      break;

    case GET_SECTOR_SIZE:
      *(WORD*)buff = 512;
      res = RES_OK;
      break;

    case GET_BLOCK_SIZE:
      /* Typical erase block size in sectors (dummy = 1) */
      *(DWORD*)buff = 1;
      res = RES_OK;
      break;

    case GET_SECTOR_COUNT:
      /* No leemos CSD aquí; devuelve 0 si no se implementa (FatFs no siempre lo requiere) */
      res = RES_PARERR;
      break;

    default:
      res = RES_PARERR;
      break;
  }
  CS_HIGH(); sd_spi_txrx(SD_DUMMY_BYTE);
  return res;
  /* USER CODE END IOCTL */
}
#endif /* _USE_IOCTL == 1 */
