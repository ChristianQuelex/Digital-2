/* Peripherals handles generated by CubeMX */
DAC_HandleTypeDef hdac;
DMA_HandleTypeDef hdma_dac1;
TIM_HandleTypeDef htim6;
UART_HandleTypeDef huart2;

/* ======== Audio engine config ======== */
#define AUDIO_FS_HZ        20000U          // Frecuencia de muestreo (20 kHz, estable y fácil de generar)
#define WT_SIZE            256U            // Tamaño de wavetable seno
#define AUDIO_BUF_SAMPLES  512U            // Doble buffer (2 x 256)
#define DAC_MAX_12B        4095U           // Resolución DAC 12 bits
#define DAC_OFFSET_12B     2048U           // Centro (offset DC)

static uint16_t audio_buf[AUDIO_BUF_SAMPLES];  // Buffer DMA (intercalado mitad/mitad)
static uint16_t wavetable[WT_SIZE];            // Seno 0..4095

/* Fase en Q16.16 (acumulador fijo) */
static uint32_t phase_q16 = 0;
static uint32_t phase_inc_q16 = 0;

/* Estado del “sintetizador” */
static float current_freq_hz = 0.0f;
static uint8_t audio_running = 0;

/* ======== Prototipos de init (de CubeMX) ======== */
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_DMA_Init(void);
static void MX_USART2_UART_Init(void);
static void MX_DAC_Init(void);
static void MX_TIM6_Init(void);

/* ======== Helpers ======== */
static void WT_InitSine(void) {
  for (uint32_t i = 0; i < WT_SIZE; ++i) {
    /* seno en [0..4095] con offset */
    float s = sinf(2.0f * 3.14159265359f * (float)i / (float)WT_SIZE);
    uint16_t v = (uint16_t)( (s * 0.49f + 0.5f) * DAC_MAX_12B ); // ±49% para evitar clipping
    wavetable[i] = v;
  }
}

static inline void Audio_SetFrequency(float freq_hz) {
  current_freq_hz = freq_hz;
  /* phase_inc = (freq / Fs) * WT_SIZE en Q16.16 */
  float step = (freq_hz * (float)WT_SIZE) / (float)AUDIO_FS_HZ;
  phase_inc_q16 = (uint32_t)(step * 65536.0f);
}

static void Audio_Start(void) {
  if (audio_running) return;

  WT_InitSine();
  /* Prellenar buffer con silencio “seno a 0 Hz” -> usar frecuencia actual si ya está fijada */
  phase_q16 = 0;
  for (uint32_t i = 0; i < AUDIO_BUF_SAMPLES; ++i) {
    /* avanzar según phase_inc_q16 */
    uint32_t idx = (phase_q16 >> 16) & (WT_SIZE - 1);
    audio_buf[i] = wavetable[idx];
    phase_q16 += phase_inc_q16;
  }

  /* Arrancar DAC con DMA en circular (TRGO de TIM6 marca la cadencia) */
  HAL_DAC_Start(&hdac, DAC_CHANNEL_1);
  HAL_DAC_Start_DMA(&hdac, DAC_CHANNEL_1, (uint32_t*)audio_buf, AUDIO_BUF_SAMPLES, DAC_ALIGN_12B_R);

  /* Arrancar TIM6 (genera update @AUDIO_FS_HZ -> TRGO) */
  HAL_TIM_Base_Start(&htim6);

  audio_running = 1;
}

static void Audio_Stop(void) {
  if (!audio_running) return;
  HAL_TIM_Base_Stop(&htim6);
  HAL_DAC_Stop_DMA(&hdac, DAC_CHANNEL_1);
  HAL_DAC_Stop(&hdac, DAC_CHANNEL_1);
  audio_running = 0;
}

/* Rellena mitad de buffer con la frecuencia actual */
static void FillHalf(uint32_t offset, uint32_t len) {
  if (phase_inc_q16 == 0) {
    for (uint32_t i = 0; i < len; ++i) audio_buf[offset + i] = DAC_OFFSET_12B;
    return;
  }
  for (uint32_t i = 0; i < len; ++i) {
    uint32_t idx = (phase_q16 >> 16) & (WT_SIZE - 1);
    audio_buf[offset + i] = wavetable[idx];
    phase_q16 += phase_inc_q16;
  }
}

/* Callbacks de mitad/fin DMA: regeneran muestras para mantener el audio continuo */
void HAL_DAC_ConvHalfCpltCallbackCh1(DAC_HandleTypeDef* hdacx) {
  (void)hdacx;
  FillHalf(0, AUDIO_BUF_SAMPLES/2);
}

void HAL_DAC_ConvCpltCallbackCh1(DAC_HandleTypeDef* hdacx) {
  (void)hdacx;
  FillHalf(AUDIO_BUF_SAMPLES/2, AUDIO_BUF_SAMPLES/2);
}

/* ======== “Player” sencillo por notas ======== */
static void PlayNoteHz_Block(float freq_hz, uint32_t dur_ms) {
  Audio_SetFrequency(freq_hz);
  if (!audio_running) Audio_Start();
  HAL_Delay(dur_ms);
}

static void PlayRest_Block(uint32_t dur_ms) {
  /* Apaga solo el tono (deja fluir el DMA con DC), o bien baja la amplitud */
  Audio_SetFrequency(0.0f);
  HAL_Delay(dur_ms);
}

/* Reproduce una melodía definida en pitches.(h/c) */
static void PlayMelody(const Note* mel, uint32_t count, uint32_t tempo_ms_per_beat) {
  for (uint32_t i = 0; i < count; ++i) {
    float freq = mel[i].freq_hz;
    uint32_t dur  = (mel[i].dur_beats * tempo_ms_per_beat) / 4; // dur_beats usa negra=4 por convención
    if (freq > 0.0f) PlayNoteHz_Block(freq, dur);
    else             PlayRest_Block(dur);
    /* pequeña pausa entre notas (staccato) */
    Audio_SetFrequency(0.0f);
    HAL_Delay(dur / 8);
  }
}

/* ================== main() ================== */
int main(void)
{
  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_DMA_Init();
  MX_USART2_UART_Init();
  MX_DAC_Init();
  MX_TIM6_Init();

  /* Arranca audio engine (sin tono al inicio) */
  Audio_SetFrequency(0.0f);
  Audio_Start();

  /* Demo: reproduce la melodía “Happy Birthday” definida en pitches.c */
  const uint32_t tempo_ms = 500; // ~120 bpm (negra ≈ 500 ms)
  PlayMelody(HAPPY_BIRTHDAY, HAPPY_BIRTHDAY_LEN, tempo_ms);

  /* Detén el audio si quieres al terminar */
  Audio_Stop();

  while (1) {
    HAL_Delay(1000);
  }
}

