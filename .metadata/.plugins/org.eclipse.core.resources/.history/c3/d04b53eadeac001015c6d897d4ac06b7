UART_HandleTypeDef huart2;

/* ===== Audio Engine Config ===== */
#define AUDIO_FS_HZ        20000U          // 20 kHz
#define WT_SIZE            256U            // wavetable seno
#define AUDIO_BUF_SAMPLES  512U            // doble buffer (2x256)
#define DAC_MAX_12B        4095U
#define DAC_OFFSET_12B     2048U

static uint16_t audio_buf[AUDIO_BUF_SAMPLES];
static uint16_t wavetable[WT_SIZE];

/* Fase en Q16.16 */
static uint32_t phase_q16     = 0;
static uint32_t phase_inc_q16 = 0;

/* Estado */
static float   current_freq_hz = 0.0f;
static uint8_t audio_running   = 0;

/* Prototipos de init (CubeMX) */
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_DMA_Init(void);
static void MX_USART2_UART_Init(void);
static void MX_DAC_Init(void);
static void MX_TIM6_Init(void);

/* ===== Helpers ===== */
static void WT_InitSine(void) {
  for (uint32_t i = 0; i < WT_SIZE; ++i) {
    float s = sinf(2.0f * 3.14159265359f * (float)i / (float)WT_SIZE);
    /* seno en [0..4095] con offset; 0.49 para evitar clipping */
    uint16_t v = (uint16_t)((s * 0.49f + 0.5f) * (float)DAC_MAX_12B);
    wavetable[i] = v;
  }
}

static inline void Audio_SetFrequency(float freq_hz) {
  current_freq_hz = freq_hz;
  float step = (freq_hz * (float)WT_SIZE) / (float)AUDIO_FS_HZ;      // ciclos de tabla por muestra
  phase_inc_q16 = (uint32_t)(step * 65536.0f);                        // Q16.16
}

static void FillHalf(uint32_t offset, uint32_t len) {
  if (phase_inc_q16 == 0) {
    for (uint32_t i = 0; i < len; ++i) audio_buf[offset + i] = DAC_OFFSET_12B;
    return;
  }
  for (uint32_t i = 0; i < len; ++i) {
    uint32_t idx = (phase_q16 >> 16) & (WT_SIZE - 1);
    audio_buf[offset + i] = wavetable[idx];
    phase_q16 += phase_inc_q16;
  }
}

static void Audio_Start(void) {
  if (audio_running) return;

  WT_InitSine();
  phase_q16 = 0;

  /* Prellenar buffer inicial */
  for (uint32_t i = 0; i < AUDIO_BUF_SAMPLES; ++i) {
    uint32_t idx = (phase_q16 >> 16) & (WT_SIZE - 1);
    audio_buf[i] = wavetable[idx];
    phase_q16 += phase_inc_q16;
  }

  /* Arrancar DAC + DMA circular, luego TIM6 */
  if (HAL_DAC_Start(&hdac, DAC_CHANNEL_1) != HAL_OK) Error_Handler();
  if (HAL_DAC_Start_DMA(&hdac, DAC_CHANNEL_1, (uint32_t*)audio_buf, AUDIO_BUF_SAMPLES, DAC_ALIGN_12B_R) != HAL_OK) Error_Handler();
  if (HAL_TIM_Base_Start(&htim6) != HAL_OK) Error_Handler();

  audio_running = 1;
}

static void Audio_Stop(void) {
  if (!audio_running) return;
  HAL_TIM_Base_Stop(&htim6);
  HAL_DAC_Stop_DMA(&hdac, DAC_CHANNEL_1);
  HAL_DAC_Stop(&hdac, DAC_CHANNEL_1);
  audio_running = 0;
}

/* Callbacks de DMA */
void HAL_DAC_ConvHalfCpltCallbackCh1(DAC_HandleTypeDef* hdacx) {
  (void)hdacx;
  FillHalf(0, AUDIO_BUF_SAMPLES/2);
  //HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin); // opcional: testigo
}
void HAL_DAC_ConvCpltCallbackCh1(DAC_HandleTypeDef* hdacx) {
  (void)hdacx;
  FillHalf(AUDIO_BUF_SAMPLES/2, AUDIO_BUF_SAMPLES/2);
  //HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin); // opcional: testigo
}

/* ===== Player por notas ===== */
static void PlayNoteHz_Block(float freq_hz, uint32_t dur_ms) {
  Audio_SetFrequency(freq_hz);
  if (!audio_running) Audio_Start();
  HAL_Delay(dur_ms);
}
static void PlayRest_Block(uint32_t dur_ms) {
  Audio_SetFrequency(0.0f);
  HAL_Delay(dur_ms);
}
static void PlayMelody(const Note* mel, uint32_t count, uint32_t tempo_ms_per_beat) {
  for (uint32_t i = 0; i < count; ++i) {
    float    freq = mel[i].freq_hz;
    uint32_t dur  = (mel[i].dur_beats * tempo_ms_per_beat) / 4; // negra=4
    if (freq > 0.0f) PlayNoteHz_Block(freq, dur);
    else             PlayRest_Block(dur);
    /* pequeño espacio entre notas */
    Audio_SetFrequency(0.0f);
    HAL_Delay(dur/8);
  }
}

/* ================== main() ================== */
int main(void)
{
  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_DAC_Init();     // DAC antes de DMA para __HAL_LINKDMA seguro
  MX_DMA_Init();
  MX_USART2_UART_Init();
  MX_TIM6_Init();

  /* Test tono 1 kHz (3 s) y luego Happy Birthday */
  Audio_SetFrequency(1000.0f);
  Audio_Start();
  HAL_Delay(3000);
  Audio_SetFrequency(0.0f);
  HAL_Delay(200);

  const uint32_t tempo_ms = 500; // negra = 500 ms (~120 bpm)
  PlayMelody(HAPPY_BIRTHDAY, HAPPY_BIRTHDAY_LEN, tempo_ms);

  Audio_Stop();

  while (1) {
    HAL_Delay(1000);
  }
}

