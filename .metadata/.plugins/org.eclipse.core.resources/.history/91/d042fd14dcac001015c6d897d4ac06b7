/* =============================================================================
 *  Export por defecto segun SELECT_SONG
 * ============================================================================= */
#if (SELECT_SONG == SONG_HARRY_POTTER)
const uint32_t MELODY_LEN = (uint32_t)len_hp;
const uint32_t melody[]   = { #define X(i) melody_hp[i]
  #undef X
};
const uint16_t durations[] = { /* se define abajo via alias */ };
/* Truco: reexportar sin copiar memoria usando alias de seccion no es portable,
   asi que definimos como referencias directas: */
const uint32_t * __mel_ptr_hp = melody_hp;
const uint16_t * __dur_ptr_hp = durations_hp;
#pragma GCC diagnostic push
#pragma GCC diagnostic ignored "-Wmissing-braces"
const uint32_t melody[sizeof(melody_hp)/sizeof(melody_hp[0])]   = { 0 };
const uint16_t durations[sizeof(durations_hp)/sizeof(durations_hp[0])] = { 0 };
#pragma GCC diagnostic pop
#elif (SELECT_SONG == SONG_IMPERIAL_MARCH)
