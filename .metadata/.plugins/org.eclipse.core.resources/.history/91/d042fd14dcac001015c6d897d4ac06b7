const uint16_t * __dur_ptr_hp = durations_ma;
const uint32_t melody[sizeof(melody_ma)/sizeof(melody_ma[0])]   = { 0 };
const uint16_t durations[sizeof(durations_ma)/sizeof(durations_ma[0])] = { 0 };
#else
#error "SELECT_SONG invalido"
#endif

/* =====================================================================
 * Nota importante:
 *   Los arrays melody[] y durations[] arriba fueron declarados con ceros
 *   para cumplir con el "extern" del main, pero queremos que apunten a
 *   la melodia elegida sin duplicar memoria. Como C puro no permite alias
 *   de arrays estaticos de forma portable, una solucion sencilla es:
 *     - Reemplazar en tu main.c el for por acceso via punteros:
 *
 *       extern const uint32_t MELODY_LEN;
 *       extern const uint32_t * __mel_ptr_hp;
 *       extern const uint16_t * __dur_ptr_hp;
 *       for (uint32_t i=0; i<MELODY_LEN; ++i) {
 *         uint32_t note = __mel_ptr_hp[i];
 *         uint16_t dur  = __dur_ptr_hp[i];
 *         ...
 *       }
 *
 *   Alternativa rapida si quieres mantener nombres:
 *     - Quitar los '= {0}' y copiar con un pequeño init en pitches_init().
 * ===================================================================== */

/* Si prefieres mantener exactamente 'melody[]' y 'durations[]' como datos reales,
 * descomenta esta funcion y llamala una vez antes de reproducir:
 *
 *   void pitches_init(void);
 *   En main.c despues de MX_*: pitches_init();
 */

void pitches_init(void)
{
#if (SELECT_SONG == SONG_HARRY_POTTER)
  for (uint32_t i=0;i<len_hp;++i){ ((uint32_t*)melody)[i]=melody_hp[i]; ((uint16_t*)durations)[i]=durations_hp[i]; }
#elif (SELECT_SONG == SONG_IMPERIAL_MARCH)
  for (uint32_t i=0;i<len_im;++i){ ((uint32_t*)melody)[i]=melody_im[i]; ((uint16_t*)durations)[i]=durations_im[i]; }
#elif (SELECT_SONG == SONG_HAPPY_BIRTHDAY)
  for (uint32_t i=0;i<len_hb;++i){ ((uint32_t*)melody)[i]=melody_hb[i]; ((uint16_t*)durations)[i]=durations_hb[i]; }
#elif (SELECT_SONG == SONG_MARIO_THEME)
  for (uint32_t i=0;i<len_ma;++i){ ((uint32_t*)melody)[i]=melody_ma[i]; ((uint16_t*)durations)[i]=durations_ma[i]; }
#endif
}
