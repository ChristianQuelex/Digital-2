#include "main.h"
#include <string.h>
#include <math.h>

#include "melody_pcm_u8.h"   // <— el header u8 (10s @ 22050 Hz) que te di

/* Handles */
DAC_HandleTypeDef  hdac;
TIM_HandleTypeDef  htim6;
DMA_HandleTypeDef  hdma_dac1;   // ¡Importante! Debe existir global

/* Player state */
static volatile uint32_t pcm8_read_idx = 0;

/* DMA work buffer (12-bit) */
#define AUDIO_DMA_SAMPLES   1024u
static uint16_t audio_dma_buf[AUDIO_DMA_SAMPLES];

/* Protos */
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_DAC_Init(void);
static void MX_TIM6_Init(void);
static void Start_Playback(void);
static void FillHalf_ExpandU8toU12(uint32_t off, uint32_t len);
void Error_Handler(void);

/* ====== main ====== */
int main(void)
{
  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_DAC_Init();
  MX_TIM6_Init();

  /* ---- TEST_TONE: descomenta para enviar un seno 1 kHz y verificar hardware ----
  {
    // Genera una tabla rápida y llena el buffer con seno (sin usar PCM8)
    for (uint32_t i=0;i<AUDIO_DMA_SAMPLES;i++) {
      float s = sinf(2.0f*3.14159265f * (float)i / (float)AUDIO_DMA_SAMPLES * 1000.0f/21875.0f);
      audio_dma_buf[i] = (uint16_t)((s*0.48f + 0.5f)*4095.0f);
    }
  }
  // -------------------------------------------------------------------------- */

  /* Prellenar desde PCM8 (comentado si estás con TEST_TONE) */
  pcm8_read_idx = 0;
  FillHalf_ExpandU8toU12(0, AUDIO_DMA_SAMPLES);

  Start_Playback();

  while (1) {
    HAL_Delay(1000);
  }
}

/* ===== U8 -> U12 fill ===== */
static void FillHalf_ExpandU8toU12(uint32_t off, uint32_t len)
{
  static uint16_t lut[256];
  static uint8_t  inited = 0;
  if (!inited) {
    for (int i=0;i<256;i++) lut[i] = (uint16_t)((i * 4095 + 127) / 255);
    inited = 1;
  }
  for (uint32_t i=0;i<len;i++) {
    uint8_t s8 = PCM8_DATA[pcm8_read_idx++];
    if (pcm8_read_idx >= PCM8_NUM_SAMPLES) pcm8_read_idx = 0; // loop
    audio_dma_buf[off+i] = lut[s8];
  }
}

/* ===== DMA callbacks ===== */
void HAL_DAC_ConvHalfCpltCallbackCh1(DAC_HandleTypeDef* _)
{
  (void)_;
  FillHalf_ExpandU8toU12(0, AUDIO_DMA_SAMPLES/2);
}

void HAL_DAC_ConvCpltCallbackCh1(DAC_HandleTypeDef* _)
{
  (void)_;
  FillHalf_ExpandU8toU12(AUDIO_DMA_SAMPLES/2, AUDIO_DMA_SAMPLES/2);
}

/* ===== Start playback ===== */
static void Start_Playback(void)
{
  if (HAL_DAC_Start(&hdac, DAC_CHANNEL_1) != HAL_OK) Error_Handler();

  if (HAL_DAC_Start_DMA(&hdac, DAC_CHANNEL_1,
                        (uint32_t*)audio_dma_buf,
                        AUDIO_DMA_SAMPLES,
                        DAC_ALIGN_12B_R) != HAL_OK) Error_Handler();

  if (HAL_TIM_Base_Start(&htim6) != HAL_OK) Error_Handler();
}

/* ===== Clocks (HSE->PLL 84 MHz) ===== */
void SystemClock_Config(void)
{
  RCC_OscInitTypeDef RCC_OscInitStruct = {0};
  RCC_ClkInitTypeDef RCC_ClkInitStruct = {0};
  __HAL_RCC_PWR_CLK_ENABLE();
  __HAL_PWR_VOLTAGESCALING_CONFIG(PWR_REGULATOR_VOLTAGE_SCALE3);

  RCC_OscInitStruct.OscillatorType = RCC_OSCILLATORTYPE_HSE;
  RCC_OscInitStruct.HSEState       = RCC_HSE_ON;
  RCC_OscInitStruct.HSIState       = RCC_HSI_OFF;
  RCC_OscInitStruct.PLL.PLLState   = RCC_PLL_ON;
  RCC_OscInitStruct.PLL.PLLSource  = RCC_PLLSOURCE_HSE;
  RCC_OscInitStruct.PLL.PLLM       = 8;
  RCC_OscInitStruct.PLL.PLLN       = 336;
  RCC_OscInitStruct.PLL.PLLP       = RCC_PLLP_DIV4;     // 84 MHz
  RCC_OscInitStruct.PLL.PLLQ       = 7;
  if (HAL_RCC_OscConfig(&RCC_OscInitStruct) != HAL_OK) Error_Handler();

  RCC_ClkInitStruct.ClockType      = RCC_CLOCKTYPE_HCLK|RCC_CLOCKTYPE_SYSCLK|
                                     RCC_CLOCKTYPE_PCLK1|RCC_CLOCKTYPE_PCLK2;
  RCC_ClkInitStruct.SYSCLKSource   = RCC_SYSCLKSOURCE_PLLCLK;
  RCC_ClkInitStruct.AHBCLKDivider  = RCC_SYSCLK_DIV1;
  RCC_ClkInitStruct.APB1CLKDivider = RCC_HCLK_DIV2;     // PCLK1=42 => TIM6=84 MHz (x2)
  RCC_ClkInitStruct.APB2CLKDivider = RCC_HCLK_DIV1;
  if (HAL_RCC_ClockConfig(&RCC_ClkInitStruct, FLASH_LATENCY_2) != HAL_OK) Error_Handler();
}

/* ===== TIM6 ~21.875 kHz =====
   84e6/(PSC+1)/(ARR+1) ≈ 21875 (cercano a 22050)
   PSC=79 -> 1.05 MHz; ARR=47 -> 1.05e6/48 ≈ 21875
*/
static void MX_TIM6_Init(void)
{
  TIM_MasterConfigTypeDef sMasterConfig = {0};
  htim6.Instance               = TIM6;
  htim6.Init.Prescaler         = 79;
  htim6.Init.CounterMode       = TIM_COUNTERMODE_UP;
  htim6.Init.Period            = 47;
  htim6.Init.AutoReloadPreload = TIM_AUTORELOAD_PRELOAD_ENABLE;
  if (HAL_TIM_Base_Init(&htim6) != HAL_OK) Error_Handler();

  sMasterConfig.MasterOutputTrigger = TIM_TRGO_UPDATE;
  sMasterConfig.MasterSlaveMode     = TIM_MASTERSLAVEMODE_DISABLE;
  if (HAL_TIMEx_MasterConfigSynchronization(&htim6, &sMasterConfig) != HAL_OK) Error_Handler();
}

