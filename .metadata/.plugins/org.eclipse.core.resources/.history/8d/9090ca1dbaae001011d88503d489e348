/* === Debounce HIGH estable === */
static uint8_t DebounceReadHigh(GPIO_TypeDef* port, uint16_t pin, uint32_t ms)
{
  if (HAL_GPIO_ReadPin(port, pin) != GPIO_PIN_SET) return 0;
  uint32_t t0 = HAL_GetTick();
  while ((HAL_GetTick() - t0) < ms) {
    if (HAL_GPIO_ReadPin(port, pin) != GPIO_PIN_SET) return 0;
    HAL_Delay(1);
  }
  return 1;
}

/* Preempción por flanco: cambio inmediato de melodía */
static void TryPreemptOnRising(GPIO_PinState *prev, GPIO_TypeDef* port, uint16_t pin,
                               uint32_t *last_fire_ms,
                               const Note* mel, unsigned count, const char* tag)
{
  GPIO_PinState now = HAL_GPIO_ReadPin(port, pin);
  if (*prev == GPIO_PIN_RESET && now == GPIO_PIN_SET) {
    uint32_t now_ms = HAL_GetTick();
    if ((now_ms - *last_fire_ms) >= RETRIGGER_BLANK_MS && DebounceReadHigh(port, pin, DEBOUNCE_MS)) {
      log_uart("[PREEMPT %s] start melody (%u notes)\r\n", tag, count);
      MelodyStart(mel, count, CSV_TEMPO_MS);  /* <-- cambio inmediato */
      *last_fire_ms = HAL_GetTick();
    }
  }
  *prev = now;
}
